# Database — SQLite for local development. For PostgreSQL see README.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://dya:password@localhost:5432/dya_portal?schema=public"

PORT=4000
# Public URL of the web client (used in email links and CORS)
APP_URL=http://localhost:5173
NODE_ENV=development

# Key used to encrypt CNIC / passport numbers at rest (AES-256-GCM). Use a long random string.
DATA_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# SMTP. Leave SMTP_HOST empty to disable sending — emails are then logged as FAILED ("SMTP not configured").
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Directorate of Youth Affairs <no-reply@example.gov.pk>"

# Where uploaded files are stored (outside the web root)
UPLOAD_DIR=./storage/uploads
# Set to true when served behind HTTPS so cookies are Secure
COOKIE_SECURE=false
